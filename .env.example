NODE_ENV=development
DATABASE_URL=postgresql://starlight:starlight_local@localhost:54329/starlight
TEST_DATABASE_URL=postgresql://starlight:starlight_local@localhost:54329/starlight_test
JWT_SECRET=replace-with-at-least-32-random-characters
QR_SECRET=replace-with-another-32-random-characters
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
PORT=4000
# MoMo sandbox. Never commit real credentials.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/?payment=momo
# Must be a public HTTPS URL that forwards to the API while testing locally.
MOMO_IPN_URL=https://your-public-domain.example/api/v1/webhooks/payments/momo
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# n8n Cloud Webhook Automation
N8N_WEBHOOK_URL=https://your-workspace.app.n8n.cloud/webhook/starlight-cinema-webhook
N8N_WEBHOOK_SECRET=replace-with-a-secure-random-secret
N8N_WEBHOOK_TIMEOUT=10000
N8N_WEBHOOK_MAX_RETRIES=3
# Set these only for the protected first-manager CLI, never in source control.
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_PASSWORD=
INITIAL_CINEMA_NAME=
INITIAL_CINEMA_IDS=
