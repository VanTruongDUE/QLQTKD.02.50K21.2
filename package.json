{
  "name": "starlight-cinema",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @starlight/api --filter @starlight/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @starlight/api db:migrate",
    "test": "pnpm --filter @starlight/api test",
    "test:coverage": "pnpm --filter @starlight/api test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:up": "docker compose -f compose.test.yaml up -d --build",
    "test:e2e:down": "docker compose -f compose.test.yaml down",
    "lint": "oxlint apps packages",
    "format": "prettier --write apps packages *.json *.yaml docs README.md"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0"
  }
}
